# Frontend environment variables (copy to .env.local)
# Anything prefixed with VITE_ is bundled into the public JavaScript, so never put secret keys here.
# Stripe secret keys and Twilio credentials belong in backend/.env.local only.

# Root URL of the Next.js backend (no trailing /api). Leave empty to run in demo mode,
# where payments and SMS are simulated in the browser. To use the real backend, set e.g.
# VITE_API_BASE_URL=http://localhost:3001
VITE_API_BASE_URL=

# Stripe publishable key (safe to expose)
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
